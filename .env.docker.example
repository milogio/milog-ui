# Address reachable from inside the UI container. This default connects to an
# API container whose port 8980 is published on the Docker host.
MILOG_API_URL=http://host.docker.internal:8980

# At least 32 random characters. Never commit the populated .env.docker file.
MILOG_SESSION_SECRET=

# Approved Terms of Service URL, required to enable signup. /terms was approved
# on 2026-10-09; set it after this deployment's API and email gates pass.
MILOG_TERMS_URL=
