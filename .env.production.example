# Copy to .env.production on the UI VM; keep that populated file outside Git.
# Replace both image inputs with the repository and sha256 digest returned by the registry.
MILOG_UI_REPOSITORY=ghcr.io/milogio/milog-ui
MILOG_UI_DIGEST=

# Exact public HTTPS origin chosen for this deployment. No trailing slash.
# Set the API VM's MILOG_UI_URL to this same value before enabling signup.
MILOG_UI_ORIGIN=https://app.milog.ca

# Supply one persistent, independently generated base64 value of at least 48 random bytes.
# Generate outside Git: openssl rand -base64 48
MILOG_SESSION_SECRET=

# Keep signup disabled until API, SMTP and log-safety checks pass; then set /terms.
MILOG_TERMS_URL=
