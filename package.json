{
  "name": "milog-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/validate-runtime.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run contract:check && npm run lint && npm run typecheck && npm run test:run && npm run build",
    "contract:generate": "openapi-typescript contracts/public-api.oas.yaml -o lib/generated/public-api.ts && openapi-typescript contracts/ui-api.oas.yaml -o lib/generated/ui-api.ts",
    "contract:check": "node scripts/check-openapi-contract.mjs",
    "clean": "rm -rf .next coverage",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
