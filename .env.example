# Required at runtime. Server-only URL reachable from the UI server/container.
# Local: http://localhost:8980
# Docker network: http://milog-nginx
# Do not expose this through NEXT_PUBLIC_*.
MILOG_API_URL=http://localhost:8980

# Optional host port for the UI Compose service.
MILOG_UI_PORT=3000

# At least 32 random characters. Used to encrypt authenticated UI sessions.
# Generate one for local development with: openssl rand -base64 32
MILOG_SESSION_SECRET=

# Approved Terms of Service URL. Set to /terms after the public page is
# approved by the product/legal owner, or use another approved HTTPS URL.
# Signup is unavailable until this is set. Local development may use localhost.
MILOG_TERMS_URL=

# Optional build-time release identifier for rolling-deployment skew protection.
DEPLOYMENT_VERSION=
