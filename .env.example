# Server-only base URL for the MiLog API. Do not expose this through NEXT_PUBLIC_*.
MILOG_API_URL=http://localhost:8980

# At least 32 random characters. Used to encrypt authenticated UI sessions.
# Generate one for local development with: openssl rand -base64 32
MILOG_SESSION_SECRET=

# Current API compatibility contract. Remove these after the API implements
# tenant-bound /auth/login, /auth/session, and /auth/logout endpoints.
MILOG_PASSPORT_CLIENT_ID=
MILOG_PASSPORT_CLIENT_SECRET=
MILOG_TIMELINE_API_KEY=
MILOG_LOCAL_TENANT_ID=
MILOG_LOCAL_TENANT_NAME=
