NEXT_PUBLIC_MILOG_API_URL=https://api.milog.local

# Optional fallback for Laravel Passport password grant login.
MILOG_PASSPORT_CLIENT_ID=
MILOG_PASSPORT_CLIENT_SECRET=

# Optional local timeline fallback. When set, timeline requests use X-API-Key
# instead of the authenticated bearer token.
MILOG_TIMELINE_API_KEY=

# Optional labels used when the local API exposes /api/user but not /api/me.
MILOG_LOCAL_TENANT_ID=
MILOG_LOCAL_TENANT_NAME=
